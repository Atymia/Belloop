          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì, l'ho usato"
          }
        }
      }
    },
    "You've searched a lot in a short time. Suggestions will be back in a few seconds." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai fatto molte ricerche in poco tempo. I suggerimenti tornano tra qualche secondo."
