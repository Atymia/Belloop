    },
    "We've picked what's about to expire. Tap to add or remove anything." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo già scelto quello che sta per scadere. Tocca per aggiungere o togliere qualcosa."
