          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché alcune ricette suonano un po' strane?"
          }
        }
      }
    },
    "Without a photo or an icon, your initials are shown." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza foto o icona vengono mostrate le tue iniziali."
